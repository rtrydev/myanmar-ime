#!/bin/sh
# Refresh system caches the package touched. Idempotent — running on
# upgrade is fine.

set -e

case "$1" in
    configure)
        # GSettings: rebuild the binary cache so the new schema is
        # visible to all running apps without a re-login.
        if command -v glib-compile-schemas >/dev/null 2>&1; then
            glib-compile-schemas /usr/share/glib-2.0/schemas/ || true
        fi
        # Hicolor icon theme: pick up the new SVG.
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi
        # .desktop file index.
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q || true
        fi
        # Restart IBus for the calling user, not as root. Skipped when
        # apt is invoked headlessly (no SUDO_USER) — user can run
        # `ibus restart` manually.
        if [ -n "${SUDO_USER:-}" ] \
           && command -v ibus >/dev/null 2>&1; then
            sudo -u "$SUDO_USER" ibus restart >/dev/null 2>&1 || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

#DEBHELPER#

exit 0
