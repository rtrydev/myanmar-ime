<Application x:Class="Myangler.Preferences.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Fluent / Win11 control palette. Brushes underneath are
                rebuilt by Theme.cs (which reads the system Personalize
                key on startup and re-reads on WM_SETTINGCHANGE), so
                everything here that references {DynamicResource Theme.*}
                follows the live system theme.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
