venv
.venv

# VSCode workspace state. settings.json holds the developer's local
# Swift toolchain absolute path (e.g. ~/.local/share/swiftly/...),
# which is per-machine. Ignore the whole dir; if shared launch.json /
# extensions.json are wanted later, negate them selectively here.
.vscode/

# Large data files (compiled into SQLite at build time)
*.tsv
!Packages/BurmeseIMECore/Sources/BurmeseIMECore/Data/NumberMeasureWords.tsv

# SQLite transient sidecars — WAL/coordination state, never source
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

tasks
pipeline-run.log

# vcpkg manifest-mode install root (Windows native shell deps).
vcpkg_installed/

# .NET build outputs for the Windows Preferences app (WPF / .NET 9).
**/bin/
**/obj/
